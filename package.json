{
  "name": "reify",
  "version": "0.1.0",
  "type": "module",
  "description": "An extensible learning blog framework built with Astro and MDX",
  "bin": {
    "reify": "./cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./config.d.mts",
      "default": "./config.mjs"
    },
    "./config": {
      "types": "./config.d.mts",
      "default": "./config.mjs"
    },
    "./content": {
      "types": "./content.d.mts",
      "default": "./content.mjs"
    },
    "./components/*": "./dist/components/*",
    "./lib/*": "./dist/lib/*",
    "./client/*": "./dist/scripts/*",
    "./build/*": "./dist/build/*",
    "./math": "./dist/math-style.js",
    "./build/*.mjs": "./dist/build/*.js"
  },
  "files": [
    "config.mjs",
    "config.d.mts",
    "content.mjs",
    "content.d.mts",
    "cli.mjs",
    "dist",
    "public",
    "README.md"
  ],
  "scripts": {
    "test": "node cli.mjs test --root examples/minimal",
    "dev": "node cli.mjs dev --root examples/minimal",
    "build": "npm run typecheck && node cli.mjs build --root examples/minimal",
    "compile": "node scripts/build-runtime.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.workers.json && tsc --noEmit -p tsconfig.tools.json && npm run typecheck:astro",
    "prepare": "npm run compile",
    "prepack": "npm run typecheck",
    "typecheck:astro": "npm run compile && astro check --root examples/minimal"
  },
  "dependencies": {
    "@astrojs/internal-helpers": "0.13.0",
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/mdx": "8.1.1",
    "@mdx-js/mdx": "3.1.1",
    "@shikijs/rehype": "4.5.0",
    "astro": "7.4.2",
    "darkreader": "4.9.133",
    "decode-named-character-reference": "1.3.0",
    "github-slugger": "2.0.0",
    "hast-util-from-html-isomorphic": "2.0.0",
    "html2canvas": "1.4.1",
    "katex": "0.16.22",
    "parse5": "7.3.0",
    "preact": "11.0.2",
    "preact-render-to-string": "6.8.1",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "shiki": "4.5.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "26.6.5",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
