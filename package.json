{
  "name": "reify",
  "version": "0.1.0",
  "type": "module",
  "description": "An extensible learning blog framework built with Astro and MDX",
  "bin": {
    "reify": "./cli.mjs"
  },
  "exports": {
    ".": "./config.mjs",
    "./config": "./config.mjs",
    "./content": "./content.mjs",
    "./components/*": "./src/components/*",
    "./lib/*": "./src/lib/*",
    "./client/*": "./src/scripts/*",
    "./build/*": "./src/build/*",
    "./math": "./src/math-style.mjs"
  },
  "files": [
    "config.mjs",
    "content.mjs",
    "cli.mjs",
    "src",
    "public",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "node cli.mjs dev --root examples/minimal",
    "build": "node cli.mjs build --root examples/minimal"
  },
  "dependencies": {
    "darkreader": "4.9.133",
    "astro": "7.4.2",
    "@astrojs/mdx": "8.1.1",
    "@astrojs/markdown-remark": "^7.3.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "rehype-katex": "7.0.1",
    "katex": "0.16.22",
    "parse5": "7.3.0",
    "html2canvas": "1.4.1",
    "shiki": "4.5.0",
    "@mdx-js/mdx": "3.1.1",
    "@astrojs/internal-helpers": "0.13.0",
    "preact": "11.0.2",
    "preact-render-to-string": "6.8.1",
    "@shikijs/rehype": "4.5.0",
    "rehype-raw": "7.0.0",
    "github-slugger": "2.0.0",
    "decode-named-character-reference": "1.3.0",
    "hast-util-from-html-isomorphic": "2.0.0"
  },
  "license": "MIT"
}
