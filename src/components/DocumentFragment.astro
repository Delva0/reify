---
import {compileDocument} from '../build/document-compiler.js';
import {mdxComponents} from '../mdx-components.js';
import DocumentView from './DocumentView.astro';
import * as runtime from 'astro/jsx-runtime';

const {code,format,id,sourceUrl,title}=Astro.props;
const components=mdxComponents();
let Content,error;
try{
 Content=await compileDocument(code,{format,components,site:Astro.locals.site,runtime});
}catch(reason){
 error=reason.message;
}
---
<DocumentView id={id} title={title} sourceUrl={sourceUrl} error={error}>
 {Content&&<Content components={components}/>}
</DocumentView>
