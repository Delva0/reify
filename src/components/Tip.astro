---
const {id,interactive=false}=Astro.props;
---
<span id={id} class:list={['tip',interactive?'annotation-desc':'control-tip']} role="tooltip" hidden data-floating-panel data-floating-layer={!interactive?'title':undefined} data-floating-persistent={!interactive||undefined} style={!interactive?'z-index:2147483647':undefined}/>
