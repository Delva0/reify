---
import Icon from './Icon.astro';
---
<section class="reader-annotation-editor" role="dialog" aria-label="编辑批注" hidden data-floating-panel data-floating-layer="200" data-reader-annotation-ui data-html2canvas-ignore>
  <textarea class="reader-annotation-input" aria-label="批注内容" placeholder="写批注…" rows="1" spellcheck="false"/>
  <div class="reader-annotation-actions">
    <span class="reader-annotation-kind">文本</span><span class="reader-annotation-status" role="status"/>
    <button class="icon-button" data-reader-annotation-cancel aria-label="关闭"><Icon name="close"/></button>
    <button class="icon-button" data-reader-annotation-confirm aria-label="复制批注" data-tip="复制" aria-keyshortcuts="Control+Enter"><Icon name="check"/></button>
  </div>
</section>
